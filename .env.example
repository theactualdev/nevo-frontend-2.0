# Nevo frontend environment variables.
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored.

# Base URL of the FastAPI backend the API client talks to (src/lib/api/client.ts).
# NEXT_PUBLIC_* is exposed to the browser — never put a secret behind this prefix.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Comma-separated origins (LAN IPs / hostnames) allowed to reach the dev server
# cross-origin — e.g. your computer's Wi-Fi IP for testing on a phone. Dev-only
# (Next.js `allowedDevOrigins`); unset means localhost-only.
# ALLOWED_DEV_ORIGINS=192.168.1.23,192.168.1.24
# Public origin, used for metadataBase (canonical + OG/Twitter image URLs),
# robots.txt and sitemap.xml. MUST be set per environment - it is read at
# BUILD time, so changing it requires a redeploy. Production:
# NEXT_PUBLIC_SITE_URL=https://www.nevolearning.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- End-to-end suite (e2e/) ---------------------------------------------
# The signed-in suites SKIP unless these are set, so a normal `npm run e2e`
# stays signed-out and read-only. Never commit real values: put them in
# `.env.local` locally and in CI secrets for the pipeline.
#
# The seeded E2E tenant is school code NEVO-E2E. Its admin holds all seven
# scopes, so every console surface is reachable.
# E2E_ADMIN_EMAIL=admin@e2e.nevolearning.com
# E2E_ADMIN_PASSWORD=
# E2E_TEACHER_EMAIL=teacher.busy@e2e.nevolearning.com
# E2E_TEACHER_PASSWORD=
#
# The STUDENT suite needs no password of its own, and that is deliberate.
# A child signs in with school code + login identifier + PIN, and there is no
# safe way to keep a child's PIN in a secret store: it is four to eight digits,
# only the child chooses it, and it is the one credential a child is told out
# loud. So the suite MAKES one at runtime instead - it signs in as the admin
# above, CLEARS the probe student's PIN (POST /api/v1/students/{id}/pin/clear),
# then chooses four digits through POST /api/v1/student-entry/pin with the
# child's Student ID, and signs in with them. Nothing durable is stored.
#
# The tenant was re-seeded on 4 Oct 2026 with
# 40 students across 8 classes, so nothing needs enrolling. Their E2E/001-040
# are admission numbers; the suite matches the minted login (NV-...).
#
# NOTE: running the student suite CHANGES that student's PIN. Pick a probe
# account nobody is reading by hand.
# E2E_STUDENT_LOGIN=NV-DF323F
# E2E_STUDENT_ADMISSION=E2E/002
#
# Override where the suite points, for a staging backend or a local one.
# E2E_API_BASE=https://nevo-backend-2-0-kn3d.onrender.com
# E2E_BASE_URL=http://localhost:3100
